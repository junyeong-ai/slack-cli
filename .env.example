# Slack CLI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Required Configuration
# ============================================

# Slack User Token (recommended for Real-time Search and user-visible private data)
# Get this from: https://api.slack.com/apps → Your App → OAuth & Permissions
# Run `slack-cli auth scopes` for the exact scope list to register.
# Format: xoxp-...
SLACK_USER_TOKEN=xoxp-your-user-token-here

# ============================================
# Optional Configuration
# ============================================

# Slack Bot Token (optional, from OAuth & Permissions)
# Format: xoxb-...
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# The Slack app `slack-cli auth login` authorizes against. Prefer
# `[auth] client_id` in config.toml, which no child process inherits.
# A bot token is registered with `--method static --bot-token`.
# SLACK_CLI_CLIENT_ID=your-client-id

# Database and Cache Location
# Default: the platform config directory, e.g. ~/.config/slack-cli/cache
# DATA_PATH=~/.config/slack-cli/cache

# Log filter. Takes precedence over --verbose when set; default is `warn`.
# Examples:
#   - All modules debug: RUST_LOG=debug
#   - Specific module: RUST_LOG=slack_cli::cache=debug
#   - Multiple modules: RUST_LOG=slack_cli::cache=debug,slack_cli::slack=info
# RUST_LOG=slack_cli=debug
